#!/bin/bash
set -euo pipefail

INHIBIT_PID=""

cleanup() {
  if [[ -n "$INHIBIT_PID" ]]; then
    kill "$INHIBIT_PID" 2>/dev/null || true
  fi
  exit 0
}
trap cleanup SIGTERM SIGINT EXIT

sync_power_state() {
  if omarchy-power-present 2>/dev/null || grep -q 1 /sys/class/power_supply/AC*/online 2>/dev/null; then
    omarchy toggle idle stay-awake >/dev/null 2>&1 || true
    if [[ -z "$INHIBIT_PID" ]] || ! kill -0 "$INHIBIT_PID" 2>/dev/null; then
      systemd-inhibit --what=sleep:idle --who="omarchy-ac-keep-awake" --why="Keep PC on when plugged in" sleep infinity &
      INHIBIT_PID=$!
    fi
  else
    omarchy toggle idle allow-idle >/dev/null 2>&1 || true
    if [[ -n "$INHIBIT_PID" ]]; then
      kill "$INHIBIT_PID" 2>/dev/null || true
      INHIBIT_PID=""
    fi
  fi
}

sync_power_state

udevadm monitor --kernel --subsystem-match=power_supply 2>/dev/null | while read -r _; do
  sync_power_state
done
